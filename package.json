{
  "name": "@courtmesh/sdk",
  "version": "0.4.0",
  "description": "Official TypeScript SDK for the CourtMesh API.",
  "license": "MIT",
  "author": "Thinkscoop Technologies LLP",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "courtmesh",
    "legal",
    "case-law",
    "india",
    "sdk"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
